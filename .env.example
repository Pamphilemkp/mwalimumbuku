# Public Supabase settings for the Next.js app at the repository root.
# Names only. Leave the values empty in git.
#
# These correspond to the existing Vite variables:
#   NEXT_PUBLIC_SUPABASE_URL             -> VITE_SUPABASE_URL
#   NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY -> VITE_SUPABASE_PUBLISHABLE_KEY
#
# NEXT_PUBLIC_SITE_URL is optional. Set it to the staging origin, including
# https, so password-reset emails use that host. Example:
#   https://staging.example.com
# When it is empty, the server uses the request host. Production refuses
# an http origin.
#
# Copy this file to .env.local and fill the values on your machine.
# Never commit .env, .env.local, or any file that contains real keys.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=
